---
import BaseLayout from '~/layouts/BaseLayout.astro';
import HomeLattice from '~/components/HomeLattice.astro';
import '~/styles/home.css';
import siteConfig from '~/config/site';
import { graph, personSchema, websiteSchema } from '~/lib/jsonld';

const jsonLd = graph([personSchema(siteConfig), websiteSchema(siteConfig)]);

const identities = [
  {
    title: 'Lawyer',
    lines: [
      'A practising lawyer in Guangzhou, focused on labour disputes and employment compliance.',
      'From the clauses of an employment contract, to the calculation behind a termination, to a staff handbook that holds up.',
    ],
    items: ['Labour arbitration and litigation', 'Employment compliance review', 'Workplace policies and redundancy planning'],
  },
  {
    title: 'AI developer',
    lines: [
      'Writing code is a long-standing habit. The repetitive parts of legal work go to tools; the judgement stays human.',
      'Document processing, desktop apps, agent tooling, and a resource index.',
    ],
    items: [
      'skills-for-legal — Chinese legal AI skills',
      'doc-anonymizer — local document anonymisation',
      'dev-resources — motion, icons and component index',
    ],
  },
];

const blocks = [
  {
    id: 'legal-products',
    title: 'Legal products',
    note: 'Reusable tools built from legal practice — for lawyers and for developers building legal products.',
    items: [
      { label: 'skills-for-legal', note: 'Chinese legal AI skills', href: 'https://github.com/law-products/skills-for-legal' },
      { label: 'doc-anonymizer', note: 'Local document anonymisation', href: 'https://github.com/law-products/doc-anonymizer' },
      { label: 'doc-flip-video', note: 'Document flip videos', href: 'https://github.com/law-products/doc-flip-video' },
    ],
    all: { label: 'github.com/law-products', href: 'https://github.com/law-products' },
  },
  {
    id: 'tech-products',
    title: 'Tech products',
    note: 'Document processing, desktop apps, agent tooling, and a continuously updated resource index.',
    items: [
      { label: 'dev-resources', note: 'Motion / sound / icons / UI', href: 'https://github.com/lawyerch-dev/dev-resources' },
      { label: 'cc-ai-tools', note: 'Extensible launcher', href: 'https://github.com/lawyerch-dev/cc-ai-tools' },
      { label: 'cc-md-editor', note: 'Markdown editor', href: 'https://github.com/lawyerch-dev/cc-md-editor' },
    ],
    all: { label: 'github.com/lawyerch-dev', href: 'https://github.com/lawyerch-dev' },
  },
];
---

<BaseLayout
  title="Chen Heng — Lawyer & Independent Developer"
  description="Guangzhou-based lawyer who writes code. Legal tech and AI development: knowledge assets, legal tools, open-source projects."
  appendSiteName={false}
  jsonLd={jsonLd}
  bodyClass="home-v3"
  homeNav
>
  <section class="hv-stage">
    <HomeLattice />

    <div class="hv-copy">
      <p class="hv-kicker">陈恒 · Lawyer</p>

      <h1 class="hv-headline">
        Legal experience, <em>written into code</em>.<br />
        Judgement stays human.
      </h1>

      <p class="hv-lede">
        A lawyer in Guangzhou focused on labour disputes and employment compliance. Days go to cases and
        contracts; evenings go to turning the repetitive parts into tools — document anonymisation, AI
        skills and a domain site, all open source on GitHub.
      </p>

      <ul class="hv-roles">
        <li>Lawyer</li>
        <li>AI developer</li>
        <li>Legal writer</li>
      </ul>
    </div>

    <div class="hv-scroll" aria-hidden="true">
      <span></span>
      Scroll
    </div>
  </section>

  <div class="hv-body">
    <div class="hv-paper">

      <div class="hv-fold">
        {
          identities.map((id) => (
            <details>
              <summary>{id.title}</summary>
              <div class="hv-fold-body">
                {id.lines.map((line) => (
                  <p>{line}</p>
                ))}
                <ul>
                  {id.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>

      {
        blocks.map((block) => (
          <section class="hv-block" id={block.id}>
            <div class="hv-block-head">
              <h2 class="hv-block-title">{block.title}</h2>
              <p class="hv-block-note">{block.note}</p>
            </div>
            <ul class="hv-list">
              {block.items.map((item) => (
                <li>
                  <a href={item.href} target="_blank" rel="noopener">
                    <b>{item.label}</b>
                    <span>{item.note}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="hv-block-link" href={block.all.href} target="_blank" rel="noopener">
              {block.all.label}
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </section>
        ))
      }

      <section class="hv-block">
        <div class="hv-block-head">
          <h2 class="hv-block-title">Say hello</h2>
          <p class="hv-block-note">
            For legal matters please engage formally. For tools, open source or collaboration, email works.
          </p>
        </div>
        <ul class="hv-contact-links">
          <li><a href="mailto:lawyerch@foxmail.com">lawyerch@foxmail.com</a></li>
          <li><a href="/en/contact/">Contact form</a></li>
          <li><a href="https://labor.lawyerch.cn/en/contact/" target="_blank" rel="noopener">Labour law enquiry</a></li>
        </ul>
      </section>
    </div>
  </div>

  <script>
    const lattice = document.querySelector<SVGElement>('.hv-lattice svg');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (lattice && !reduce) {
      let raf = 0;
      const update = () => {
        raf = 0;
        const shift = Math.min(window.scrollY * 0.12, 140);
        lattice.style.setProperty('--hv-shift', `${shift}px`);
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!raf) raf = requestAnimationFrame(update);
        },
        { passive: true }
      );
    }
  </script>
</BaseLayout>
