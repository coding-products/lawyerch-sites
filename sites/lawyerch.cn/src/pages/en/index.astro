---
import BaseLayout from '~/layouts/BaseLayout.astro';
import '~/styles/home.css';
import siteConfig from '~/config/site';
import { graph, personSchema, websiteSchema } from '~/lib/jsonld';

const jsonLd = graph([personSchema(siteConfig), websiteSchema(siteConfig)]);

const lines = [
  {
    eyebrow: 'Legal tech',
    title: 'Turning legal experience into tools',
    body: 'Knowledge assets, AI skills and document tools — for lawyers and for developers building legal products.',
    links: [
      { label: 'skills-for-legal', note: 'Chinese legal AI skills', href: 'https://github.com/law-products/skills-for-legal' },
      { label: 'doc-anonymizer', note: 'Local document anonymisation', href: 'https://github.com/law-products/doc-anonymizer' },
      { label: 'doc-flip-video', note: 'Document flip videos', href: 'https://github.com/law-products/doc-flip-video' },
    ],
    all: { label: 'github.com/law-products', href: 'https://github.com/law-products' },
  },
  {
    eyebrow: 'AI development',
    title: 'Build things that run and ship',
    body: 'Document processing, desktop apps, agent tooling, and a continuously updated resource index.',
    links: [
      { label: 'dev-resources', note: 'Motion / sound / icons / UI', href: 'https://github.com/lawyerch-dev/dev-resources' },
      { label: 'cc-ai-tools', note: 'Extensible launcher', href: 'https://github.com/lawyerch-dev/cc-ai-tools' },
      { label: 'cc-md-editor', note: 'Markdown editor', href: 'https://github.com/lawyerch-dev/cc-md-editor' },
    ],
    all: { label: 'github.com/lawyerch-dev', href: 'https://github.com/lawyerch-dev' },
  },
];
---

<BaseLayout
  title="Chen Heng — Lawyer & Independent Developer"
  description="Guangzhou-based lawyer who writes code. Legal tech and AI development: knowledge assets, legal tools, open-source projects."
  appendSiteName={false}
  jsonLd={jsonLd}
  bodyClass="home-v2"
  homeNav
>
  <div class="hv-frame">
    <div class="hv-card">
      <section class="hv-hero">
        <p class="hv-label">TL;DR</p>
        <h1 class="hv-title">Chen Heng, <em>Esq.</em></h1>
        <p class="hv-lede">
          A lawyer in Guangzhou who writes code — handing the repetitive parts of legal work to machines
          and keeping the judgement human.
        </p>

        <dl class="hv-meta">
          <div>
            <dt>Practice</dt>
            <dd>Labour disputes · Employment compliance</dd>
          </div>
          <div>
            <dt>Two tracks</dt>
            <dd>Legal tech <span aria-hidden="true">/</span> AI development</dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>Guangzhou · remote-friendly</dd>
          </div>
        </dl>
      </section>

      <section class="hv-sec" id="work">
        <div class="hv-sec-head">
          <p class="hv-label">Work</p>
          <h2 class="hv-sec-title">What I am building</h2>
        </div>

        <div class="hv-lines">
          {
            lines.map((line) => (
              <div class="hv-line">
                <h3>{line.title}</h3>
                <p>{line.body}</p>
                <ul class="hv-list">
                  {line.links.map((link) => (
                    <li>
                      <a href={link.href} target="_blank" rel="noopener">
                        <b>{link.label}</b>
                        <span>{link.note}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="hv-list-all" href={line.all.href} target="_blank" rel="noopener">
                  {line.all.label}
                </a>
              </div>
            ))
          }
        </div>
      </section>

      <section class="hv-sec">
        <div class="hv-sec-head">
          <p class="hv-label">Domain</p>
          <h2 class="hv-sec-title">Labour law</h2>
        </div>
        <div class="hv-domain">
          <p>
            A dedicated site for labour disputes, employment compliance, workplace policies and redundancy
            planning. For practical articles or a consultation, that is the place to go.
          </p>
          <a href="https://labor.lawyerch.cn/en/" target="_blank" rel="noopener">
            Visit labor.lawyerch.cn
          </a>
        </div>
      </section>

      <section class="hv-sec">
        <div class="hv-sec-head">
          <p class="hv-label">Contact</p>
          <h2 class="hv-sec-title">Say hello</h2>
          <p class="hv-sec-note">
            For legal matters please engage formally. For tools, open source or collaboration, email works.
          </p>
        </div>
        <ul class="hv-contact-links">
          <li><a href="mailto:lawyerch@foxmail.com">lawyerch@foxmail.com</a></li>
          <li><a href="/en/contact/">Contact form</a></li>
          <li><a href="https://labor.lawyerch.cn/en/contact/" target="_blank" rel="noopener">Labour law enquiry</a></li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
