---
import BaseLayout from '~/layouts/BaseLayout.astro';
import '~/styles/home.css';
import siteConfig from '~/config/site';
import { graph, personSchema, websiteSchema } from '~/lib/jsonld';

const jsonLd = graph([personSchema(siteConfig), websiteSchema(siteConfig)]);

const lines = [
  {
    eyebrow: '法律科技',
    title: '把法律经验做成可复用的工具',
    body: '知识资产、AI 技能、文档工具。面向法律人，也面向做法律产品的开发者。',
    links: [
      { label: 'skills-for-legal', note: '中国法实务 AI 技能集', href: 'https://github.com/law-products/skills-for-legal' },
      { label: 'doc-anonymizer', note: '本地文档脱敏', href: 'https://github.com/law-products/doc-anonymizer' },
      { label: 'doc-flip-video', note: '文档翻页视频', href: 'https://github.com/law-products/doc-flip-video' },
    ],
    all: { label: 'github.com/law-products', href: 'https://github.com/law-products' },
  },
  {
    eyebrow: 'AI 开发',
    title: '做能跑、能交付的东西',
    body: '文档处理、桌面应用、Agent 工具链，以及一份持续更新的开发资源索引。',
    links: [
      { label: 'dev-resources', note: '动效 / 音效 / 图标 / UI', href: 'https://github.com/lawyerch-dev/dev-resources' },
      { label: 'cc-ai-tools', note: '可扩展启动器', href: 'https://github.com/lawyerch-dev/cc-ai-tools' },
      { label: 'cc-md-editor', note: 'Markdown 编辑器', href: 'https://github.com/lawyerch-dev/cc-md-editor' },
    ],
    all: { label: 'github.com/lawyerch-dev', href: 'https://github.com/lawyerch-dev' },
  },
];
---

<BaseLayout
  title="陈恒律师 — 执业律师 · AI 独立开发者"
  description="广州执业律师，用代码做法律工具。法律科技与 AI 开发两条线：知识资产、法律工具、开源项目。"
  appendSiteName={false}
  jsonLd={jsonLd}
  bodyClass="home-v2"
  homeNav
>
  <div class="hv-frame">
    <div class="hv-card">
      <section class="hv-hero">
        <p class="hv-label">TL;DR</p>
        <h1 class="hv-title">陈恒<em>律师</em></h1>
        <p class="hv-lede">广州执业律师，用代码把法律工作里重复的部分交给机器，把判断留给人。</p>

        <dl class="hv-meta">
          <div>
            <dt>执业领域</dt>
            <dd>劳动争议 · 企业用工合规</dd>
          </div>
          <div>
            <dt>两条线</dt>
            <dd>法律科技 <span aria-hidden="true">／</span> AI 开发</dd>
          </div>
          <div>
            <dt>所在地</dt>
            <dd>广州 · 可远程协作</dd>
          </div>
        </dl>
      </section>

      <section class="hv-sec" id="work">
        <div class="hv-sec-head">
          <p class="hv-label">Work</p>
          <h2 class="hv-sec-title">正在做的事</h2>
        </div>

        <div class="hv-lines">
          {
            lines.map((line) => (
              <div class="hv-line">
                <h3>{line.title}</h3>
                <p>{line.body}</p>
                <ul class="hv-list">
                  {line.links.map((link) => (
                    <li>
                      <a href={link.href} target="_blank" rel="noopener">
                        <b>{link.label}</b>
                        <span>{link.note}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="hv-list-all" href={line.all.href} target="_blank" rel="noopener">
                  {line.all.label}
                </a>
              </div>
            ))
          }
        </div>
      </section>

      <section class="hv-sec">
        <div class="hv-sec-head">
          <p class="hv-label">Domain</p>
          <h2 class="hv-sec-title">劳动法</h2>
        </div>
        <div class="hv-domain">
          <p>
            一个独立的领域站，写劳动争议、用工合规、规章制度与裁员方案。想找实务文章或约一次咨询，去那里更直接。
          </p>
          <a href="https://labor.lawyerch.cn" target="_blank" rel="noopener">
            访问 labor.lawyerch.cn
          </a>
        </div>
      </section>

      <section class="hv-sec">
        <div class="hv-sec-head">
          <p class="hv-label">Contact</p>
          <h2 class="hv-sec-title">聊一聊</h2>
          <p class="hv-sec-note">法律问题请走正式委托；工具、开源、合作可以直接发邮件。</p>
        </div>
        <ul class="hv-contact-links">
          <li><a href="mailto:lawyerch@foxmail.com">lawyerch@foxmail.com</a></li>
          <li><a href="/contact/">联系表单</a></li>
          <li><a href="https://labor.lawyerch.cn/contact/" target="_blank" rel="noopener">劳动法咨询</a></li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
