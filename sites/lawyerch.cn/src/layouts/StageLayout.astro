---
/**
 * 复刻版首页专用外壳。
 * 不套用全站的 Header / Footer / 悬浮导航 —— 版面完全由首页自己控制。
 * 需要回到全站统一页头时，把 index.astro 换回 BaseLayout 即可。
 */
import '~/styles/stage.css';
import Seo from '~/components/Seo.astro';
import siteConfig from '~/config/site';
import { theme } from '~/config/theme';

interface Props {
  title: string;
  description?: string;
  jsonLd?: string;
}

const { title, description, jsonLd } = Astro.props;

const themeCss = Object.entries(theme)
  .map(([key, value]) => `--swp-${key}: ${value};`)
  .join(' ');
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <style is:inline set:html={`:root{${themeCss}}`}></style>

    <link rel="preload" href="/fonts/noto-serif-sc-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-serif-sc-400.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <Seo title={title} description={description} appendSiteName={false} jsonLd={jsonLd} />
  </head>
  <body class="rp-page">
    <a class="rp-sr" href="#main">跳到正文</a>
    <slot />
  </body>
</html>
