---
import Icon from './Icon.astro';
import siteConfig from '~/config/site';
import { footerNav } from '~/data/navigation';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';
import { isVisible } from '~/lib/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'en' ? '/en' : '';

const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr-top">
    <div>
      <a class="ftr-brand" href="/">
        <img
          src={siteConfig.logo.footer.src}
          alt={`${siteConfig.name} — home`}
          width={siteConfig.logo.footer.width}
          height={siteConfig.logo.footer.height}
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="ftr-about">{lang === 'en' ? siteConfig.aboutEn : siteConfig.about}</p>
      <div class="ftr-soc">
        {
          siteConfig.social.map((s) => (
            <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
              <Icon name={s.icon} class="ic-sm" />
            </a>
          ))
        }
      </div>
    </div>

    <nav aria-labelledby="ftr-explore">
      <h2 id="ftr-explore">{t.footer.explore}</h2>
      <ul class="ftr-links">
        {footerNav.explore.map((l) => <li><a href={l.href.startsWith("http") ? l.href : `${base}${l.href}`} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener" : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>


    <div>
      <h2>{t.footer.contact}</h2>
      <div class="ftr-cbox">
        <Icon name="mail" class="ic-sm" />
        <span><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></span>
      </div>
      {siteConfig.contact.phone && (
        <div class="ftr-cbox">
          <Icon name="phone" class="ic-sm" />
          <span><a href={`tel:${siteConfig.contact.phoneHref}`}>{siteConfig.contact.phone}</a></span>
        </div>
      )}
      <div class="ftr-cbox">
        <Icon name="pin" class="ic-sm" />
        <span>{siteConfig.contact.location}</span>
      </div>
    </div>
  </div>

  <div class="wrap ftr-bot">
    <p>
      &copy; {year} {siteConfig.copyrightHolder}
      <a
        class="ftr-icp"
        href="https://beian.miit.gov.cn"
        target="_blank"
        rel="noopener noreferrer">{siteConfig.icp}</a
      >
    </p>
    <nav aria-label="法律信息">
      {footerNav.legal.map((l) => <a href={`${base}${l.href}`}>{l.label}</a>)}
    </nav>
  </div>
</footer>
