---
import { chenhengConfig } from '~/config/chenheng';

const { slogan } = chenhengConfig;
---

<section class="st" id="st" aria-label="首屏">
  <!-- 问题场的坐标晶格与电流 -->
  <canvas class="st__v" id="bg-cv" aria-hidden="true"></canvas>
  <div class="st__shade"></div>

  <!-- 首屏主张：法律问题 × AI 解法 -->
  <div class="st__copy">
    <div class="ch-wrap st__hero">
      <span class="st__eb" data-a style="--d:0" data-noi18n><i></i>{slogan.kicker}</span>
      <h2 class="st__title" data-a style="--d:100">
        <span data-en="Legal problems">法律问题</span><em aria-hidden="true">×</em><span data-en="AI solutions">AI 解法</span>
      </h2>
      <div class="st__three" data-a style="--d:380">
        <span data-en="Legal problems">法律问题</span>
        <a class="st__cta" id="hero-cta" href="#products" data-en="See how I solve">
          <span class="st__br" aria-hidden="true">[</span>
          <span>看我怎么解</span>
          <span class="st__br" aria-hidden="true">]</span>
        </a>
        <span data-en="Verifiable results">可验证的结果</span>
      </div>
    </div>
  </div>

  <!-- 左下伪代码：用普通人能看懂的方式说明我在做什么 -->
  <pre class="st__code" data-a style="--d:640" data-noi18n aria-label="我在做的事：把法律问题放进「事实 × 规则」的图谱，沿连接找出通往解法的路径，让每一步都有据可查。"><code id="hero-type"></code><span class="st__cur" aria-hidden="true"></span></pre>

  <!-- 底部状态：把倒计时换成“正在解” -->
  <div class="st__status" data-a style="--d:760">
    <span class="st__dot" aria-hidden="true"></span>
    <span data-en="Solving · Labor disputes / Contract review / Legal knowledge base">正在解 · 劳动争议 / 合同审查 / 法律知识库</span>
  </div>

  <p class="st__note" data-a style="--d:680" data-noi18n>不只回答问题，<br>也把解法做成可复用的工具。</p>

  <button type="button" class="st__cue" id="cue" aria-label="向下"><i></i>SCROLL</button>
</section>
