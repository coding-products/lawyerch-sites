---
import { mqcConfig } from '~/config/mqcConfig';

const { slogan, person, credentials } = mqcConfig;
---

<section class="st" id="st" aria-label="首屏">
  <!-- 核心 WebGL/Canvas 坐标晶格背景与电流游走动画 -->
  <canvas class="st__v" id="bg-cv" aria-hidden="true"></canvas>
  <div class="st__shade"></div>

  <!-- 第 1 屏标语 -->
  <div class="st__copy">
    <div class="qc-wrap st__in">
      <span class="st__eb" data-a style="--d:0" data-noi18n><i></i>{slogan.kicker}</span>
      <h2 class="st__slo">
        <span><i style="--d:80" data-en={slogan.line1.en}>{slogan.line1.zh}<br class="mbr" />{slogan.line1Sub.zh}</i></span>
        <span><i style="--d:200" data-en={slogan.line2.en}>{slogan.line2.zh}<br class="mbr" />{slogan.line2Sub.zh}</i></span>
      </h2>
      <p class="st__p" data-a style="--d:520" data-en={slogan.desc.en}>{slogan.desc.zh}</p>
    </div>
  </div>

  <button type="button" class="st__cue" id="cue" aria-label="向下"><i></i>SCROLL</button>

  <!-- 第 2 屏：白幕 + 鼠标可拖动的立体坐标交互 + 资历折叠 -->
  <div class="sheet" id="sheet">
    <canvas class="sheet__cv" id="hx-cv" aria-hidden="true"></canvas>
    <div class="sheet__in">
      <div class="qc-wrap ab">
        <div class="ab__r" data-b style="--d:0">
          <div class="ab__ph">
            <img src={person.cutout} alt={`${person.nameZh}律师`} width="1374" height="1500" />
          </div>
          <div class="ab__nm">
            <b data-en={person.nameEn}>{person.nameZh}</b>
            <span>{person.nameEn} · Lawyer</span>
          </div>

          <div class="idl" id="idl">
            {credentials.map((c, i) => (
              <button type="button" class={`idl__i ${i === 0 ? 'is-on' : ''}`} data-ax={i}>
                <span class="idl__h">
                  <b data-en={c.titleEn}>{c.titleZh}</b>
                  <i class="idl__pm"></i>
                </span>
                <span class="idl__d">
                  <span>
                    {c.isParagraph ? (
                      <em class="is-p" data-en={c.paragraph?.en}>{c.paragraph?.zh}</em>
                    ) : (
                      c.items?.map((item) => (
                        <em>
                          <span class="u">{item.u1}</span>
                          <span class="u">{item.u2}</span>
                        </em>
                      ))
                    )}
                  </span>
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
