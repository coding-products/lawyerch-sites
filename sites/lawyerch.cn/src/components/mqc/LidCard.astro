---
import { mqcConfig } from '~/config/mqcConfig';

const { person, roles, nav } = mqcConfig;
---

<!-- 顶部常驻/吸顶导航栏 -->
<header class="gate-header" id="gate-header">
  <nav class="qc-nav">
    <div class="qc-wrap qc-nav__inner">
      <a href="index.html" class="qc-nav__brand" aria-label={`${person.nameZh}首页`}>
        <img class="qc-nav__logo" id="nav-logo" src={person.avatar} alt={person.nameZh} width="640" height="640" />
        <span class="qc-nav__wordmark" id="nav-wm">
          <span class="qc-nav__wordmark-text">{person.nameZh}律师</span>
          <span class="qc-nav__wm-en" data-noi18n>{person.nameEn}</span>
        </span>
      </a>
      <button type="button" class="qc-nav__toggle" aria-label="打开菜单" aria-expanded="false">
        <i></i><i></i>
      </button>
      <div class="qc-nav__links" data-i18n-split>
        {nav.map((item) => (
          <a class="qc-nav__link" aria-current={item.current ? 'page' : undefined} href={item.href}>
            <span data-en={item.en}>{item.zh}</span>
          </a>
        ))}
        <a class="qc-nav__gh" href={person.githubUrl} target="_blank" rel="noopener" aria-label={`GitHub @${person.github}`}>
          <img src="/images/qc/icon-github-ink.svg" alt="" width="28" height="28" />
        </a>
      </div>
      <button type="button" class="qc-lang" data-noi18n aria-label="切换语言 / Switch language">
        <span data-l="zh">中</span><i></i><span data-l="en">EN</span>
      </button>
    </div>
  </nav>
</header>

<!-- 悬浮名片大门（四周留空，如精美物理名片置于 3D 舞台之上） -->
<div class="gate-portal" id="gate-portal" aria-label="名片仪式大门">
  <!-- 右上角独立语言切换器，与名片整体分离，保持右上角整洁 -->
  <button type="button" class="lang gate-lang" id="lang" data-noi18n aria-label="切换语言 / Switch language">
    <span data-l="zh">中</span><i></i><span data-l="en">EN</span>
  </button>

  <!-- 名片实体容器（居中浮动，左右开门） -->
  <div class="gate-card-frame">
    <!-- 扭索纹背景纹理 -->
    <canvas class="card__gl gate-gl" id="card-gl" aria-hidden="true"></canvas>

    <!-- 年份水印：整张名片只有一份，斜穿上下/左右两扇门 -->
    <span class="gate-year" aria-hidden="true">2026</span>

    <!-- 左门扇：承载头像、姓名、头衔 -->
    <div class="gate-door gate-door--left">
      <div class="gate-half gate-half--left">
        <div class="card__id">
          <div class="card__who">
            <img class="card__av" id="av" src={person.avatar} alt={person.nameZh} width="640" height="640" />
            <div class="card__nm">
              <h1 class="card__name" data-en={person.nameEn}>{person.nameZh}</h1>
              <span class="card__en" data-en={person.nameZh}>{person.nameEn}</span>
            </div>
          </div>
          <ul class="card__tt">
            {roles.map((r) => (
              <li data-en={r.en}>{r.zh}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- 右门扇：承载联系方式、按钮组、二维码 -->
    <div class="gate-door gate-door--right">
      <div class="gate-half gate-half--right">
        <div class="card__ct">
          <dl class="vc">
            <div class="vc__r" id="vc-tel">
              <dt>
                <svg class="vc__ic" viewBox="0 0 24 24" role="img" aria-label="电话" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8.2 4.3 9.9 8 8.2 9.9c.9 2 2.4 3.6 4.5 4.5l1.9-1.7 3.7 1.7v3.2c0 1.1-.9 1.9-2 1.8C9.9 19 5 14.1 4.4 7.7c-.1-1.1.7-2 1.8-2h2z"></path></svg>
              </dt>
              <dd><a class="num" id="vc-tel-a" href={`tel:${person.tel.replace(/[^\d+]/g, '')}`}>{person.telFormatted}</a></dd>
            </div>
            <div class="vc__r">
              <dt>
                <svg class="vc__ic" viewBox="0 0 24 24" role="img" aria-label="邮件" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.2" y="5.4" width="17.6" height="13.2" rx="2.6"></rect><path d="m3.9 7.3 7.1 5c.6.4 1.4.4 2 0l7.1-5"></path></svg>
              </dt>
              <dd><a href={`mailto:${person.mail}`}>{person.mail}</a></dd>
            </div>
            <div class="vc__r">
              <dt>
                <svg class="vc__ic vc__ic--fill" viewBox="0 0 16 16" role="img" aria-label="GitHub" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
              </dt>
              <dd><a href={person.githubUrl} target="_blank" rel="noopener">{person.github}</a></dd>
            </div>
          </dl>
        </div>

        <figure class="qr">
          <div class="qr__box">
            <img src={person.qr} alt="微信二维码" width="624" height="624" />
          </div>
        </figure>
      </div>
    </div>

    <!-- 中缝裁切线 -->
    <div class="gate-seam__line" aria-hidden="true"></div>
  </div>

  <!-- 中缝古风门环：暗示左右/上下对开，可直接点击开门 -->
  <button type="button" class="gate-latch" id="gate-latch" aria-label="开启大门">
    <span class="gate-latch__arrows" aria-hidden="true"><i></i><i></i></span>
    <svg class="gate-latch__dial" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" fill="none" stroke="currentColor">
      <circle cx="20" cy="20" r="17" stroke-opacity=".6" stroke-width="1"/>
      <circle cx="20" cy="20" r="2.2" fill="currentColor" fill-opacity=".85" stroke="none"/>
    </svg>
  </button>

  <!-- 开门触发提示 -->
  <div class="gate-seam__badge" id="gate-cue" aria-label="向下滑动或点击开启大门">
    <div class="gate-seam__icon">
      <i></i><i></i>
    </div>
    <span>向下滑动 / 点击开启</span>
  </div>
</div>
