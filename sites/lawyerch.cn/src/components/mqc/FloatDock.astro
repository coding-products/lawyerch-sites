---
/**
 * 悬浮操作：
 *   - 联系我：打开名片页（复用 GateHero 的开门状态机，不重复渲染名片）
 *   - 返回顶部：滚过一屏后出现
 */
---
<div class="dock" aria-label="快捷操作">
  <button type="button" class="dock__b dock__top" id="dock-top" aria-label="返回顶部">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
    <span>顶部</span>
  </button>
  <button type="button" class="dock__b dock__cta" id="dock-contact" aria-label="打开名片，联系陈恒">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4.5 7.5 12 13l7.5-5.5"/></svg>
    <span>联系我</span>
  </button>
</div>

<style>
  .dock {
    position: fixed;
    right: clamp(16px, 2.2vw, 28px);
    bottom: clamp(16px, 2.2vw, 28px);
    z-index: 55;
    display: grid;
    gap: 10px;
    justify-items: stretch;
    transition: opacity 240ms ease;
  }
  /* 名片页开着时让位 */
  html.st-0 .dock { opacity: 0; pointer-events: none; }

  .dock__b {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid rgba(244, 231, 206, .2);
    border-radius: 2px;
    background: rgba(12, 12, 14, .82);
    color: rgba(244, 231, 206, .86);
    font: 500 12px/1 var(--qc-sans);
    letter-spacing: .06em;
    cursor: pointer;
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    transition: color 200ms ease, border-color 200ms ease, background 200ms ease, opacity 260ms ease, transform 260ms var(--ease-o);
  }
  .dock__b svg {
    width: 15px;
    height: 15px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dock__b:hover { color: #fff; border-color: rgba(244, 231, 206, .42); background: rgba(20, 20, 22, .92); }
  .dock__cta { color: #e8c98a; border-color: rgba(217, 179, 106, .42); }
  .dock__cta:hover { color: #fff3d8; border-color: rgba(217, 179, 106, .7); background: rgba(38, 32, 20, .9); }

  .dock__top { opacity: 0; transform: translateY(8px); pointer-events: none; }
  .dock__top.is-on { opacity: 1; transform: none; pointer-events: auto; }

  @media (max-width: 760px) {
    .dock { right: 14px; bottom: 14px; gap: 8px; }
    .dock__b { height: 38px; padding: 0 12px; }
  }

  html[data-theme="light"] .dock__b { background: rgba(255, 255, 255, .92); border-color: rgba(30, 30, 29, .16); color: rgba(30, 30, 29, .8); }
  html[data-theme="light"] .dock__b:hover { color: #111; border-color: rgba(30, 30, 29, .34); background: #fff; }
  html[data-theme="light"] .dock__cta { color: #8a5f16; border-color: rgba(160, 110, 30, .42); }
  html[data-theme="light"] .dock__cta:hover { color: #3d2a08; border-color: rgba(160, 110, 30, .66); background: #fff; }
</style>

<script>
  const topBtn = document.getElementById('dock-top');
  const contactBtn = document.getElementById('dock-contact');

  if (topBtn && contactBtn) {
    const sync = () => topBtn.classList.toggle('is-on', window.scrollY > window.innerHeight * 0.9);
    window.addEventListener('scroll', sync, { passive: true });
    sync();

    topBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    contactBtn.addEventListener('click', () => {
      const openCard = (window as Window & { qcOpenCard?: () => void }).qcOpenCard;
      if (openCard) openCard();
      else window.location.href = '/contact/';
    });
  }
</script>
