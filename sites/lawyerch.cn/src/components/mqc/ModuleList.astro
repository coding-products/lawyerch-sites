---
import { mqcConfig } from '~/config/mqcConfig';

const { modules, previewImages } = mqcConfig;
---

<section class="md" id="modules" aria-labelledby="md-title">
  <div class="qc-wrap">
    <div class="md__h">
      <div><h2 id="md-title" data-en="Explore">全部内容</h2></div>
    </div>
    <div class="mx" id="mx">
      {modules.map((m) => (
        <a class="mr" href={m.href} data-pv={m.pvIndex}>
          <span class="mr__t">
            <b data-en={m.titleEn}>{m.titleZh}</b>
          </span>
          <span class="mr__d" data-en={m.descEn}>{m.descZh}</span>
          <span class="mr__a">
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 9h12M10 4l5 5-5 5" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>

  <!-- 跟随鼠标的悬停预览卡 -->
  <div class="pv" id="pv" aria-hidden="true">
    {previewImages.map((p) => (
      <img class={p.isCustom ? 'is-c is-w' : ''} src={p.src} alt="" width="560" height="400" loading="lazy" />
    ))}
  </div>
</section>
