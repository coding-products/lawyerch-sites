---
/**
 * GateHero · 开门 + 名片 + hero 的首屏体验
 * ------------------------------------------------------------
 * 把「红名片 → 开门 → hero」这一套收在一个组件里：
 *   - 名片 / 门 / 年份水印 / 飞行头像：LidCard
 *   - hero 首屏：HeroStage
 *   - 交互脚本：vcard / hero-bg / home-card / home
 *
 * 用法（需放在 MqcLayout 内，后续内容走默认插槽）：
 *   <GateHero>
 *     <LegalProducts />
 *     <LegalFde />
 *     <ContactFooter />
 *   </GateHero>
 */
import LidCard from '~/components/mqc/LidCard.astro';
import HeroStage from '~/components/mqc/HeroStage.astro';
---
<LidCard />
<HeroStage />
<slot />

<script is:inline defer src="/js/qc/hero-bg.js"></script>
<script is:inline defer src="/js/qc/home-card.js"></script>
<script is:inline defer src="/js/qc/home.js"></script>
