---
import { getLangFromUrl } from '~/i18n/ui';
import { headings } from '~/data/headings';

const lang = getLangFromUrl(Astro.url);
const h = headings[lang];
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import siteConfig from '~/config/site';

interface Props {
  id?: string;
}

const { id = 'cta' } = Astro.props;
---

<section class="wrap sec-tight" id={id} aria-labelledby="cta-h">
  <div class="cta rev">
    <span class="cta-ring a" aria-hidden="true"></span>
    <span class="cta-ring b" aria-hidden="true"></span>

    <p class="eyebrow">{siteConfig.contact.availability}</p>
    <h2 class="d2" id="cta-h">{h.cta.title}</h2>
    <p>{h.cta.body}</p>

    <div class="cta-actions">
      <Button href="/contact/" variant="ink">{h.cta.primaryLabel}</Button>
      {siteConfig.contact.phone ? (
        <a class="btn btn-outline-ink" href={`tel:${siteConfig.contact.phoneHref}`}>
          <span>{siteConfig.contact.phone}</span>
          <i><Icon name="phone" class="ic-sm" /></i>
        </a>
      ) : (
        <a class="btn btn-outline-ink" href={`mailto:${siteConfig.contact.email}`}>
          <span>邮件</span>
          <i><Icon name="mail" class="ic-sm" /></i>
        </a>
      )}
    </div>
  </div>
</section>
