---
import { getLangFromUrl } from '~/i18n/ui';
import { headings } from '~/data/headings';

const lang = getLangFromUrl(Astro.url);
const h = headings[lang];
import Button from '../Button.astro';
import SectionHeading from '../SectionHeading.astro';
import ServiceCard from '../cards/ServiceCard.astro';
import { getCollection } from 'astro:content';
import { isVisible } from '~/lib/utils';

const services = (await getCollection('services', ({ data }) => data.lang === lang))
  .filter(isVisible)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="wrap sec sec-top" id="services" aria-labelledby="svc-h">
  <SectionHeading class="rev" eyebrow={h.servicesHeading.eyebrow} title={h.servicesHeading.title} id="svc-h">
    <Button href={h.servicesHeading.ctaHref} variant="outline">{h.servicesHeading.ctaLabel}</Button>
  </SectionHeading>

  <div class="svc">
    {
      services.map((service, i) => (
        <ServiceCard service={service} class:list={['rev', i % 3 > 0 && `rev-d${i % 3}`]} />
      ))
    }
  </div>
</section>
