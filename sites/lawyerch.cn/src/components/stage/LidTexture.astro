---
/**
 * 名片带底纹：极淡的椭圆轮廓环，模拟原站 canvas 的"水波"纹理。
 * 纯装饰，aria-hidden；窗口变化时重绘一次。
 */
---

<canvas class="rp-canvas rp-canvas--lid" data-lid-tex aria-hidden="true"></canvas>

<script>
  const cv = document.querySelector<HTMLCanvasElement>('[data-lid-tex]');

  if (cv) {
    const ctx = cv.getContext('2d');

    function hash(a: number, b: number): number {
      let x = Math.imul(a + 374761393, 668265263) ^ Math.imul(b + 1274126177, 468258671);
      x = (x ^ (x >>> 15)) * 1274126177;
      return ((x ^ (x >>> 16)) >>> 0) / 4294967295;
    }

    function draw() {
      if (!ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = cv!.getBoundingClientRect();
      const W = rect.width;
      const H = rect.height;
      if (W < 2 || H < 2) return;

      cv!.width = Math.round(W * dpr);
      cv!.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);

      const count = 96;

      for (let i = 0; i < count; i++) {
        // 右半边更密，和原站的纹理分布一致
        const bias = hash(i, 1);
        const cx = W * (0.35 + bias * 0.75);
        const cy = H * (0.1 + hash(i, 2) * 0.9);
        const rx = 18 + hash(i, 3) * 96;
        const ry = rx * (0.55 + hash(i, 4) * 0.75);
        const rot = hash(i, 5) * Math.PI;
        const light = hash(i, 6) > 0.5;

        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(rot);

        // 一部分画整圈，一部分只画半段弧，形成断口
        const full = hash(i, 7) > 0.42;
        const start = hash(i, 8) * Math.PI * 2;
        const end = full ? start + Math.PI * 2 : start + Math.PI * (0.7 + hash(i, 9) * 1.1);

        ctx.beginPath();
        ctx.ellipse(0, 0, rx, ry, 0, start, end);
        ctx.lineWidth = 0.45 + hash(i, 10) * 0.55;
        ctx.strokeStyle = light
          ? `rgba(255, 255, 255, ${0.02 + hash(i, 11) * 0.028})`
          : `rgba(0, 0, 0, ${0.028 + hash(i, 12) * 0.03})`;
        ctx.stroke();

        ctx.restore();
      }
    }

    draw();

    let timer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(draw, 180);
    });
  }
</script>
