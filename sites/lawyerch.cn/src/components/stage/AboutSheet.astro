---
/**
 * 人像 + 姓名 + 可折叠资历。
 * 第一条默认展开，其余收起；同一时间只展开一条。
 */
import stage from '~/config/stage';

const { about } = stage;
---

<section class="rp-sheet" id="about">
  <svg class="rp-sheet__bg" viewBox="0 0 900 800" preserveAspectRatio="xMaxYMin slice" aria-hidden="true">
    <defs>
      <pattern id="rp-iso2" width="42" height="24.2" patternUnits="userSpaceOnUse">
        <path
          d="M0 12.1 L21 0 L42 12.1 M21 0 L21 24.2 M0 12.1 L21 24.2 L42 12.1"
          fill="none"
          stroke="#a9afb6"
          stroke-width="0.45"
          opacity="0.62"
        />
      </pattern>
    </defs>
    <rect width="900" height="800" fill="url(#rp-iso2)" opacity="0.8" />
    <g stroke="#991b1b" stroke-width="0.7" opacity="0.34" fill="none">
      <path d="M470 470 L900 560" />
      <path d="M470 470 L880 300" />
    </g>
    <circle cx="470" cy="470" r="32" fill="none" stroke="#991b1b" stroke-width="0.7" opacity="0.26" />
    <circle cx="470" cy="470" r="3.5" fill="#991b1b" opacity="0.45" />
  </svg>

  <div class="rp-wrap rp-ab">
    <div>
      <div class:list={['rp-ab__ph', { 'rp-ab__ph--empty': !about.photo.src }]}>
        {
          about.photo.src ? (
            <img src={about.photo.src} alt={about.photo.alt} width="760" height="950" loading="lazy" />
          ) : (
            <>
              <b>{about.photo.fallback}</b>
              <span>PORTRAIT</span>
            </>
          )
        }
      </div>

      <div class="rp-ab__nm">
        <b>{about.nameZh}</b>
        <span>{about.nameEn}</span>
      </div>

      <div class="rp-idl" id="rp-idl">
        {
          about.credentials.map((group, i) => (
            <div class:list={['rp-idl__item', { 'is-open': i === 0 }]}>
              <button
                class="rp-idl__h"
                type="button"
                aria-expanded={i === 0 ? 'true' : 'false'}
              >
                <b>{group.title}</b>
                <i class="rp-idl__pm" aria-hidden="true" />
              </button>
              <div class="rp-idl__d">
                {group.items.map((item) => (
                  <em>{item}</em>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('rp-idl');
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.rp-idl__item'));
    items.forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>('.rp-idl__h');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');
        items.forEach((other) => {
          other.classList.remove('is-open');
          other.querySelector('.rp-idl__h')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }
</script>
