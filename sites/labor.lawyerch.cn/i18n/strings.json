  "bf8aea60defb": {
    "en": "劳动合同到期不续签，需要支付经济补偿吗？ — 劳动法 · 陈恒律师",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "fc9b9a9edebd": {
    "en": "结论：多数情况下需要，但不是所有情况都需要。",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "96ba4c996f79": {
    "en": "《劳动合同法》第四十六条第五项规定：除用人单位维持或者提高劳动合同约定条件续订劳动合同，劳动者不同意续订的情形外，依照本法第四十四条第一项规定终止固定期限劳动合同的，用人单位应当向劳动者支付经济补偿。",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "5a515bb43e09": {
    "en": "拆开看，合同到期终止是否补偿，取决于三件事：",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "fdedeb47c8d4": {
    "en": "谁提出不续签",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "c1228ff1dff6": {
    "en": "续签条件是否维持或提高",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "194ea8c1c2f3": {
    "en": "是否属于法定例外",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "d1ede49cb6f9": {
    "en": "常见情形",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "202ee1ce3e79": {
    "en": "是否支付经济补偿",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "fe38b7d4e486": {
    "en": "单位提出不续签",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "f2b95def8854": {
    "en": "单位维持或提高条件，员工不续签",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "6a7cd2d9358c": {
    "en": "不需要",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "347e5a304b9d": {
    "en": "单位降低条件，员工不续签",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "575b5d1d8c4e": {
    "en": "员工主动提出不续签",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "5f39b9d09ee1": {
    "en": "一般不需要",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "529f5e76a495": {
    "en": "合同到期时员工已享受基本养老保险待遇",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "2fed067146b7": {
    "en": "员工死亡、被宣告死亡或失踪",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "1c992b5d2c5b": {
    "en": "<0>“维持或提高条件”要留证据</0>：续签通知、岗位、薪资、工作地点都要写清楚，最好让员工签收。",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "01027699c96e": {
    "en": "<0>降低条件要谨慎</0>：调岗降薪再让员工“自愿不续签”，仲裁中通常仍会被认定为单位原因。",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "85c7202e8877": {
    "en": "<0>补偿年限</0>：按劳动者在本单位工作的年限，每满一年支付一个月工资；六个月以上不满一年的按一年算，不满六个月的支付半个月。",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "dd8f4d3f1710": {
    "en": "<0>月工资上限</0>：高于当地上年度职工月平均工资三倍的，按三倍封顶，年限最高十二年。",
    "kind": "unit",
    "count": 1,
    "pages": [
      "/insights/contract-expiry-compensation/"
    ]
  },
  "a57fa1bc2a0c": {
    "en": "劳动法专栏 — 劳动法 · 陈恒律师",
    "kind": "unit",
    "count": 1,
    "pages": [
