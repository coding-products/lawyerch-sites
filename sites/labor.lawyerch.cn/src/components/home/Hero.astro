---
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import siteConfig from '~/config/site';
import { hero } from '~/data/highlights';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="wrap hero" aria-labelledby="hero-h">
  <div class="hero-grid">
    <div class="hero-l rev">
      <p class="hero-hi">{t.hero.greeting}</p>
      <h1 class="d1 hero-name" id="hero-h">
        {t.hero.name.map((line) => <em>{line}</em>)}
      </h1>
      <p class="hero-copy">{t.hero.intro}</p>
      <Button href={hero.ctaHref} variant="lime">{t.hero.cta}</Button>
    </div>

    <div class="hero-card rev rev-d1">
      <div class="hero-photo">
        <img
          src={hero.photo.src}
          alt={hero.photo.alt}
          width={hero.photo.width}
          height={hero.photo.height}
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-social">
          {
            siteConfig.social.map((s) => (
              <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
                <Icon name={s.icon} class="ic-sm" />
              </a>
            ))
          }
        </div>
      </div>
      <p class="hero-avail">
        <span class="dot-live" aria-hidden="true"></span>
        {t.hero.available}
      </p>
    </div>

    <div class="hero-right rev rev-d2">
      <p class="hero-role">
        {t.hero.asideRole[0]}<br />{t.hero.asideRole[1]}
      </p>
      <h2 class="d2 hero-title2">
        {t.hero.asideTitle[0]}<br />{t.hero.asideTitle[1]}
      </h2>
      {hero.aside.stack.length > 0 && (
        <div class="hero-proof">
          <div class="stack" aria-hidden="true">
            {hero.aside.stack.map((src) => (
              <img src={src} alt="" width="76" height="76" loading="lazy" decoding="async" />
            ))}
            <span class="stack-more">{hero.aside.stackBadge}</span>
          </div>
        </div>
      )}
      <p class="hero-kpi">{hero.aside.kpi} <span>{t.hero.kpiLabel}</span></p>
      <p class="hero-note">{t.hero.note}</p>
    </div>
  </div>

  <Icon name="asterisk" class="hero-mark" />
</section>
