---
import BaseLayout from '@astro-fleet/shared-ui/src/layouts/BaseLayout.astro';
import Breadcrumb from '@astro-fleet/shared-ui/src/components/Breadcrumb.astro';
import ServiceCard from '@astro-fleet/shared-ui/src/components/ServiceCard.astro';
import CTABlock from '@astro-fleet/shared-ui/src/components/CTABlock.astro';
import { CORPORATE } from '@astro-fleet/config/tokens';
import {
  SITE_NAME,
  TAGLINE,
  LOGO_SRC,
  navigation,
  footerColumns,
  contactInfo,
  socialLinks,
} from '../lib/site-config';

const services = [
  {
    title: '劳动争议代理',
    description:
      '违法解除、经济补偿与赔偿金、加班费、未签合同双倍工资、工伤待遇、竞业限制。仲裁与诉讼全流程代理。',
    href: '/contact/',
    linkText: '咨询代理',
  },
  {
    title: '企业用工合规',
    description:
      '劳动合同、员工手册、考勤与加班制度、社保公积金、试用期与调岗。把风险挡在争议发生之前。',
    href: '/contact/',
    linkText: '咨询合规',
  },
  {
    title: '规章制度审查',
    description:
      '审查员工手册与内部制度的合法性、民主程序与公示流程，确保制度在仲裁中真正可用。',
    href: '/contact/',
    linkText: '咨询审查',
  },
  {
    title: '裁员与人员优化',
    description:
      '经济性裁员的法定条件、人员方案、补偿测算、协商谈判与政府报备，兼顾成本与合规。',
    href: '/contact/',
    linkText: '咨询方案',
  },
  {
    title: '竞业限制与保密',
    description:
      '竞业限制协议设计、补偿标准、解除与违约处理，以及商业秘密保护的配套安排。',
    href: '/contact/',
    linkText: '咨询方案',
  },
  {
    title: '劳动法培训',
    description:
      '面向 HR 与管理者的用工风险培训：招聘、入职、调岗、解除、证据留存，按企业场景定制。',
    href: '/contact/',
    linkText: '咨询培训',
  },
];
---

<BaseLayout
  showLanguages
  title={`服务 — ${SITE_NAME}`}
  description="劳动争议代理、企业用工合规、规章制度审查、裁员方案、竞业限制与劳动法培训。"
  keywords={['劳动争议代理', '用工合规', '规章制度审查', '裁员方案', '竞业限制', '劳动法培训']}
  {navigation}
  footerColumns={footerColumns}
  {contactInfo}
  {socialLinks}
  siteName={SITE_NAME}
  search
  searchPlaceholder="Services, pricing, contact"
  tagline={TAGLINE}
  logoSrc={LOGO_SRC}
  ctaText="Get Started"
  ctaHref="/contact/"
  designTokens={CORPORATE}
>
  <div class="container">
    <Breadcrumb
      items={[
        { label: '首页', href: '/' },
        { label: '服务' },
      ]}
    />
  </div>

  <!-- Page hero -->
  <section class="services-hero section">
    <div class="container">
      <h1 class="services-hero__title">服务</h1>
      <p class="services-hero__sub">
        劳动争议只是结果。真正决定结果的，往往是合同怎么签、制度怎么定、证据有没有留。
      </p>
    </div>
  </section>

  <!-- Services grid -->
  <section class="section">
    <div class="container">
      <div class="services-grid">
        {services.map((s) => (
          <ServiceCard
            title={s.title}
            description={s.description}
            href={s.href}
            linkText={s.linkText}
          />
        ))}
      </div>
    </div>
  </section>

  <CTABlock
    heading="不确定属于哪一种？"
    description="描述一下情况，我会先判断问题性质，再告诉你下一步怎么走。"
    primaryButton={{ text: '联系我', href: '/contact/' }}
    variant="light"
  />
</BaseLayout>

<style>
  .services-hero {
    background: linear-gradient(160deg, #f0f4ff 0%, #ffffff 60%);
    padding-bottom: 2rem;
  }

  .services-hero__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--color-primary, #1e3a5f);
    margin-bottom: 1rem;
  }

  .services-hero__sub {
    font-size: 1.125rem;
    color: #475569;
    line-height: 1.7;
    max-width: 560px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
