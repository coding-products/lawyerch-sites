---
import PageLayout from '~/layouts/PageLayout.astro';
import PostCard from '~/components/cards/PostCard.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { getCollection } from 'astro:content';
import { isVisible } from '~/lib/utils';
import { graph, breadcrumbSchema, personSchema } from '~/lib/jsonld';

const posts = (await getCollection('blog'))
  .filter(isVisible)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: '专栏', url: `${siteConfig.url}/journal/` },
  ]),
]);
---

<PageLayout
  title="专栏"
  heading="劳动法实务笔记。"
  eyebrow="专栏"
  intro="劳动法实务中的常见问题、判断依据和处理路径。多数文章来自被反复问到的同一个问题。"
  description="劳动法实务笔记：劳动合同、经济补偿、加班费、工伤、竞业限制与企业用工合规。"
  crumbs={[{ label: '专栏' }]}
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0" aria-labelledby="posts-h">
    <h2 class="sr-only" id="posts-h">全部文章</h2>
    {
      posts.length > 0 ? (
        <div class="posts">
          {posts.map((post, i) => (
            <PostCard
              post={post}
              headingLevel="h3"
              eager={i < 2}
              class:list={['rev', i % 3 > 0 && `rev-d${i % 3}`]}
            />
          ))}
        </div>
      ) : (
        <p class="empty">No articles yet. Add one in <code>src/content/blog/</code>.</p>
      )
    }
  </section>

  <Cta />
</PageLayout>
