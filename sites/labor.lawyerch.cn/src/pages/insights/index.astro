---
import BaseLayout from '@astro-fleet/shared-ui/src/layouts/BaseLayout.astro';
import Breadcrumb from '@astro-fleet/shared-ui/src/components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { CORPORATE } from '@astro-fleet/config/tokens';
import {
  SITE_NAME,
  TAGLINE,
  LOGO_SRC,
  navigation,
  footerColumns,
  contactInfo,
  socialLinks,
} from '../../lib/site-config';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title={`劳动法专栏 — ${SITE_NAME}`}
  description="劳动争议、劳动合同、加班费、竞业限制与企业用工合规的实务文章。"
  keywords={['劳动法', '劳动争议', '劳动合同', '加班费', '竞业限制']}
  {navigation}
  footerColumns={footerColumns}
  {contactInfo}
  {socialLinks}
  siteName={SITE_NAME}
  search
  searchPlaceholder="搜索劳动法问题"
  tagline={TAGLINE}
  logoSrc={LOGO_SRC}
  ctaText="预约咨询"
  ctaHref="/contact/"
  designTokens={CORPORATE}
>
  <div class="container">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '劳动法专栏' }]} />
  </div>

  <section class="section">
    <div class="container">
      <h1 class="page-title">劳动法专栏</h1>
      <p class="page-sub">
        记录劳动法实务中的常见问题、判断依据和处理路径。
      </p>

      <div class="post-list">
        {posts.map((post) => (
          <article class="post-item">
            <div class="post-item__meta">
              <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
              {post.data.tags.map((tag) => <span class="post-item__tag">{tag}</span>)}
            </div>
            <h2 class="post-item__title">
              <a href={`/insights/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="post-item__desc">{post.data.description}</p>
          </article>
        ))}
      </div>

      {posts.length === 0 && <p>还没有文章。</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--color-primary, #1e3a5f);
    margin-bottom: 0.75rem;
  }
  .page-sub {
    color: #475569;
    font-size: 1.0625rem;
    margin-bottom: 2.5rem;
  }
  .post-list {
    display: grid;
    gap: 1px;
    background: #e2e8f0;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .post-item {
    background: #fff;
    padding: 1.5rem;
  }
  .post-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.8125rem;
    color: #64748b;
    margin-bottom: 0.5rem;
  }
  .post-item__tag {
    background: #f1f5f9;
    border-radius: 999px;
    padding: 0.125rem 0.5rem;
  }
  .post-item__title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .post-item__title a {
    color: var(--color-primary, #1e3a5f);
    text-decoration: none;
  }
  .post-item__title a:hover {
    color: var(--color-accent, #2563eb);
  }
  .post-item__desc {
    color: #475569;
    margin: 0;
    line-height: 1.7;
  }
</style>
