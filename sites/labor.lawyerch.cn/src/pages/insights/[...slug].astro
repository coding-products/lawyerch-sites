---
import BaseLayout from '@astro-fleet/shared-ui/src/layouts/BaseLayout.astro';
import Breadcrumb from '@astro-fleet/shared-ui/src/components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import { CORPORATE } from '@astro-fleet/config/tokens';
import {
  SITE_NAME,
  TAGLINE,
  LOGO_SRC,
  navigation,
  footerColumns,
  contactInfo,
  socialLinks,
} from '../../lib/site-config';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const structuredData = {
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { '@type': 'Person', name: '陈恒律师', jobTitle: '执业律师' },
  publisher: { '@type': 'Organization', name: '劳动法 · 陈恒律师' },
  mainEntityOfPage: `https://labor.lawyerch.cn/insights/${post.id}/`,
};

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title={`${post.data.title} — ${SITE_NAME}`}
  description={post.data.description}
  keywords={post.data.tags}
  {navigation}
  footerColumns={footerColumns}
  {contactInfo}
  {socialLinks}
  siteName={SITE_NAME}
  search
  searchPlaceholder="搜索劳动法问题"
  tagline={TAGLINE}
  logoSrc={LOGO_SRC}
  ctaText="预约咨询"
  ctaHref="/contact/"
  designTokens={CORPORATE}
  structuredData={structuredData}
>
  <div class="container">
    <Breadcrumb
      items={[
        { label: '首页', href: '/' },
        { label: '劳动法专栏', href: '/insights/' },
        { label: post.data.title },
      ]}
    />
  </div>

  <article class="section">
    <div class="container article">
      <header class="article__header">
        <div class="article__meta">
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          {post.data.tags.map((tag) => <span class="article__tag">{tag}</span>)}
        </div>
        <h1 class="article__title">{post.data.title}</h1>
        <p class="article__desc">{post.data.description}</p>
      </header>

      <div class="article__body prose">
        <Content />
      </div>

      <footer class="article__footer">
        <p>
          本文为一般信息，不构成针对具体案件的法律意见。需要处理具体问题，请
          <a href="/contact/">联系我</a>。
        </p>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 760px;
  }
  .article__header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.8125rem;
    color: #64748b;
    margin-bottom: 0.75rem;
  }
  .article__tag {
    background: #f1f5f9;
    border-radius: 999px;
    padding: 0.125rem 0.5rem;
  }
  .article__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-primary, #1e3a5f);
    margin: 0 0 0.75rem;
  }
  .article__desc {
    color: #475569;
    font-size: 1.0625rem;
    line-height: 1.7;
    margin: 0;
  }
  .prose :global(h2) {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-primary, #1e3a5f);
    margin: 2rem 0 0.75rem;
  }
  .prose :global(p) {
    color: #334155;
    line-height: 1.8;
    margin: 0 0 1rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    color: #334155;
    line-height: 1.8;
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.9375rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid #e2e8f0;
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .prose :global(th) {
    background: #f8fafc;
  }
  .prose :global(blockquote) {
    border-left: 3px solid #cbd5e1;
    color: #64748b;
    margin: 1.5rem 0;
    padding-left: 1rem;
  }
  .article__footer {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
    color: #64748b;
    font-size: 0.9375rem;
  }
</style>
