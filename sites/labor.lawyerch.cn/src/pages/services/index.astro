---
import PageLayout from '~/layouts/PageLayout.astro';
import ServiceCard from '~/components/cards/ServiceCard.astro';
import Process from '~/components/home/Process.astro';
import Faq from '~/components/home/Faq.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { getCollection } from 'astro:content';
import { isVisible } from '~/lib/utils';
import { graph, breadcrumbSchema, personSchema } from '~/lib/jsonld';

const services = (await getCollection('services', ({ data }) => data.lang === 'zh'))
  .filter(isVisible)
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: '服务', url: `${siteConfig.url}/services/` },
  ]),
]);
---

<PageLayout
  title="服务"
  heading="六个服务方向。"
  eyebrow="服务"
  intro="劳动争议、用工合规、制度审查、裁员方案、竞业限制与培训。可以只做一件，也可以组合成常年顾问。"
  description="劳动争议代理、企业用工合规、规章制度审查、裁员与人员优化、竞业限制与保密、劳动法培训。"
  crumbs={[{ label: '服务' }]}
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0" aria-labelledby="svc-list-h">
    <h2 class="sr-only" id="svc-list-h">全部服务</h2>
    <div class="svc">
      {
        services.map((service, i) => (
          <ServiceCard
            service={service}
            headingLevel="h3"
            class:list={['rev', i % 3 > 0 && `rev-d${i % 3}`]}
          />
        ))
      }
    </div>
  </section>

  <Process />
  <Faq />
  <Cta />
</PageLayout>
