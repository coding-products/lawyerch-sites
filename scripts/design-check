#!/usr/bin/env python3
"""
设计底线检查。扫描构建产物，卡住可访问性和排版的最低标准。

用法：
  ./scripts/design-check <站点目录>          # 检查 dist/
  ./scripts/design-check <站点目录> --json   # 机器可读

退出码：0 通过，1 有硬性错误，2 只有警告。
"""
from __future__ import annotations

import json
import re
import sys
from pathlib import Path

OK = "\033[32m✔\033[0m"
WARN = "\033[33m⚠\033[0m"
FAIL = "\033[31m✖\033[0m"

# WCAG 对比度阈值
CONTRAST_BODY = 4.5
CONTRAST_LARGE = 3.0


def hex_to_rgb(h: str) -> tuple[int, int, int] | None:
    h = h.lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    if len(h) != 6:
        return None
    try:
        return tuple(int(h[i : i + 2], 16) for i in (0, 2, 4))  # type: ignore[return-value]
    except ValueError:
        return None


def rel_luminance(rgb: tuple[int, int, int]) -> float:
    def ch(c: int) -> float:
        s = c / 255
        return s / 12.92 if s <= 0.03928 else ((s + 0.055) / 1.055) ** 2.4

    r, g, b = (ch(c) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast_ratio(fg: str, bg: str) -> float | None:
    a, b = hex_to_rgb(fg), hex_to_rgb(bg)
    if not a or not b:
        return None
    la, lb = rel_luminance(a), rel_luminance(b)
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)


def check_theme_tokens(site: Path, issues: list, warns: list) -> None:
    """检查 theme.ts 里的前景/背景对比度。"""
    theme = site / "src" / "config" / "theme.ts"
    if not theme.exists():
        # 非 Astro 项目（没有 src/）直接跳过，不刷警告
        if (site / "src").exists():
            warns.append("未找到 src/config/theme.ts，跳过配色检查")
        return

    text = theme.read_text(encoding="utf-8")
    colors = dict(re.findall(r"['\"]?([a-z-]+)['\"]?\s*:\s*['\"](#[0-9a-fA-F]{3,8})['\"]", text))
    if not colors:
        warns.append("theme.ts 中未解析到颜色")
        return

    bg = colors.get("mist") or colors.get("shell") or "#ffffff"
    fg_candidates = {k: v for k, v in colors.items() if k in ("ink", "slate", "graphite", "faint")}

    for name, color in fg_candidates.items():
        ratio = contrast_ratio(color, bg)
        if ratio is None:
            continue
        if name in ("ink", "graphite"):
            need = CONTRAST_BODY
        else:
            need = CONTRAST_BODY
        if ratio < need:
            issues.append(f"对比度不足：{name} {color} 在 {bg} 上为 {ratio:.2f}:1，需 ≥ {need}")
        elif ratio < need + 1:
            warns.append(f"对比度偏低：{name} {color} 为 {ratio:.2f}:1（勉强达标）")

    # 强调色（lime）按设计只用于深色底或按钮背景，不作为浅底正文色。
    # 这里不做自动判断，避免误报；规则写在 .agents/skills/design-review 里人工把关。

def resolve_output(site: Path, explicit: Path | None = None) -> Path | None:
    """构建产物目录。显式指定优先；否则 Astro 站点用 dist/，纯静态站点用 public/。"""
    if explicit is not None:
        return explicit if explicit.exists() else None
    for name in ("dist", "public"):
        candidate = site / name
        if candidate.exists() and any(candidate.rglob("*.html")):
            return candidate
    return None


def check_html(site: Path, issues: list, warns: list, output: Path | None = None) -> None:
    dist = resolve_output(site, output)
    if dist is None:
        issues.append(f"{site} 下既没有 dist/ 也没有 public/ 里的 HTML，先跑 pnpm build")
        return

    pages = list(dist.rglob("*.html"))
    if not pages:
        issues.append(f"{dist.name}/ 中没有 HTML")
        return

    emoji_icon = re.compile(r"<a[^>]*>\s*[\U0001F300-\U0001FAFF\u2600-\u27BF]\s*</a>")
    img_no_size = re.compile(r"<img(?![^>]*(width=|height=|aspect-ratio))[^>]*>", re.I)
    h1_count = re.compile(r"<h1\b", re.I)

    total_img = 0
    total_img_no_size = 0
    total_emoji = 0
    multi_h1 = []
    missing_meta = []

    for page in pages:
        html = page.read_text(encoding="utf-8", errors="ignore")
        rel = page.relative_to(dist)

        # 图片尺寸
        imgs = re.findall(r"<img[^>]*>", html, re.I)
        total_img += len(imgs)
        for img in imgs:
            if not re.search(r"(width|height|aspect-ratio)\s*=", img, re.I):
                total_img_no_size += 1

        # emoji 当图标
        total_emoji += len(emoji_icon.findall(html))

        # h1 数量
        if len(h1_count.findall(html)) > 1:
            multi_h1.append(str(rel))

        # meta
        if 'name="viewport"' not in html:
            missing_meta.append(f"{rel}: 缺 viewport")
        if 'name="description"' not in html:
            missing_meta.append(f"{rel}: 缺 description")

    if total_img_no_size:
        pct = total_img_no_size / max(total_img, 1) * 100
        msg = f"{total_img_no_size}/{total_img} 张图片缺 width/height（{pct:.0f}%），会造成 CLS"
        (issues if pct > 20 else warns).append(msg)

    if total_emoji:
        issues.append(f"发现 {total_emoji} 处 emoji 用作图标")

    if multi_h1:
        issues.append(f"{len(multi_h1)} 个页面有多个 h1：{', '.join(multi_h1[:3])}")

    if missing_meta:
        for m in missing_meta[:5]:
            issues.append(m)

    print(f"{OK if not issues else WARN} 扫描 {len(pages)} 个页面，{total_img} 张图片")


def check_css(site: Path, issues: list, warns: list, output: Path | None = None) -> None:
    dist = resolve_output(site, output)
    if dist is None:
        return
    css_files = list(dist.rglob("*.css"))
    if not css_files:
        return

    tiny_font = re.compile(r"font-size\s*:\s*(\d+(?:\.\d+)?)px", re.I)
    tiny_count = 0
    motion_files: list[str] = []
    for f in css_files:
        css = f.read_text(encoding="utf-8", errors="ignore")
        for m in tiny_font.finditer(css):
            if float(m.group(1)) < 12:
                tiny_count += 1
        has_motion = re.search(r"(^|[;{\s])(animation|transition)\s*:", css)
        if has_motion and "prefers-reduced-motion" not in css:
            motion_files.append(str(f.relative_to(dist)))
    if tiny_count:
        issues.append(f"CSS 中有 {tiny_count} 处 font-size < 12px（规范硬性规则）")
    else:
        print(f"{OK} 字号检查通过")
    if motion_files:
        issues.append(
            "有动画/过渡但未处理 prefers-reduced-motion："
            + ", ".join(motion_files[:3])
        )


def check_touch_targets(dist: Path, issues: list, warns: list) -> None:
    """检查交互元素的显式高度是否 >= 44px（WCAG 2.5.5 / 规范硬性规则）。"""
    interactive_tag = re.compile(r"^(button|input|select|textarea)$", re.I)
    interactive_class = re.compile(r"\.(btn|button|cta|icon-button)(?![\w-])", re.I)
    checked = 0
    seen: set[str] = set()

    for f in dist.rglob("*.css"):
        css = f.read_text(encoding="utf-8", errors="ignore")
        for m in re.finditer(r"([^{}]+)\{([^{}]*)\}", css):
            selector_text, body = m.group(1), m.group(2)
            for selector in selector_text.split(","):
                last = re.split(r"[\s>+~]+", selector.strip())[-1]
                last = last.split("::")[0].split(":")[0].strip()
                if not last:
                    continue
                tag = re.sub(r"[.#\[].*$", "", last)
                if not (interactive_tag.match(tag) or interactive_class.search(last)):
                    continue
                for prop in ("height", "min-height"):
                    value = re.search(rf"(?:^|;)\s*{prop}\s*:\s*(\d+(?:\.\d+)?)px", body)
                    if not value:
                        continue
                    checked += 1
                    px = float(value.group(1))
                    if px < 44:
                        key = f"{f.name}:{selector.strip()}"
                        if key in seen:
                            continue
                        seen.add(key)
                        issues.append(
                            f"触控目标不足 44px：{f.name} `{selector.strip()}` "
                            f"{prop}={px:.0f}px"
                        )
    if checked and not seen:
        print(f"{OK} 触控目标检查通过（{checked} 处显式尺寸）")


def check_shape_system(dist: Path, warns: list) -> None:
    """统计圆角与阴影取值，供人工判断（规范：圆角 ≤2 种、阴影 1 套）。"""
    radii: set[str] = set()
    shadows: set[str] = set()
    for f in dist.rglob("*.css"):
        css = f.read_text(encoding="utf-8", errors="ignore")
        for value in re.findall(r"border-radius\s*:\s*([^;]+)", css, re.I):
            v = value.strip().lower()
            if v in ("0", "0px", "50%", "999px", "inherit", "none") or "var(" in v:
                continue
            radii.add(v)
        for value in re.findall(r"box-shadow\s*:\s*([^;]+)", css, re.I):
            v = value.strip().lower()
            if v in ("none", "inherit") or "var(" in v:
                continue
            # 焦点环不是阴影层级，不计入
            if re.match(r"^(inset\s+)?0\s+0\s+0\b", v):
                continue
            shadows.add(v)
    # 只报告数量，不判错：圆角/阴影收敛是设计判断，不是可机械裁决的规则
    print(f"ℹ 圆角取值 {len(radii)} 种，阴影 {len(shadows)} 种（规范建议 ≤2 / 1，需人工确认）")


def main() -> None:
    argv = sys.argv[1:]
    explicit_output: Path | None = None
    if "--output" in argv:
        i = argv.index("--output")
        if i + 1 >= len(argv):
            sys.exit("--output 需要一个目录参数")
        explicit_output = Path(argv[i + 1]).expanduser().resolve()
        del argv[i : i + 2]

    args = [a for a in argv if not a.startswith("--")]
    as_json = "--json" in argv

    if not args:
        sys.exit("用法: ./scripts/design-check <站点目录> [--output <目录>] [--json]")

    site = Path(args[0]).expanduser().resolve()
    if not site.exists():
        sys.exit(f"目录不存在：{site}")

    issues: list[str] = []
    warns: list[str] = []

    print(f"== 设计检查：{site.name} ==\n")
    check_theme_tokens(site, issues, warns)
    check_html(site, issues, warns, explicit_output)
    check_css(site, issues, warns, explicit_output)
    dist = resolve_output(site, explicit_output)
    if dist is not None:
        check_touch_targets(dist, issues, warns)
        check_shape_system(dist, warns)

    if as_json:
        print(json.dumps({"issues": issues, "warnings": warns}, ensure_ascii=False, indent=2))
    else:
        print()
        if issues:
            print("== 必须修复 ==")
            for i in issues:
                print(f"{FAIL} {i}")
        if warns:
            print("\n== 建议改进 ==")
            for w in warns:
                print(f"{WARN} {w}")
        if not issues and not warns:
            print(f"{OK} 全部通过")

    sys.exit(1 if issues else (2 if warns else 0))


if __name__ == "__main__":
    main()
