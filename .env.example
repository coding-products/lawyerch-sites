# ============================================================
# 我的网站 · 环境变量模板
# 复制为 .env 后填写，.env 已被 .gitignore 忽略
#   cp .env.example .env
# ============================================================

# ---------- 构建 ----------
# 正式域名，决定 canonical、sitemap、hreflang
# 主站：https://lawyerch.cn
# 劳动法站：https://labor.lawyerch.cn
SITE_URL=https://lawyerch.cn

# ---------- Netlify ----------
# 本地已 netlify login 时可不填；CI 或脚本部署需要
NETLIFY_AUTH_TOKEN=
# 站点 ID（netlify sites:list 可查）
NETLIFY_SITE_ID=

# ---------- Cloudflare ----------
# 备用部署平台；wrangler login 后可省略
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---------- 百度搜索资源平台 ----------
# 普通收录推送 token，在「资源提交 → 普通收录」页获取
BAIDU_TOKEN=

# ---------- 站点验证 ----------
# 已内联在 BaseLayout.astro，一般不需要改
# 如需环境变量注入，可在此填写
GOOGLE_SITE_VERIFICATION=
BAIDU_SITE_VERIFICATION=

# ---------- 旧服务器（已弃用） ----------
# lawyerch.cn 已迁移到 Netlify，仅在需要回滚时使用
SSH_HOST=
SSH_USER=root
DEPLOY_PATH=/var/www/lawyerch
CDN_DOMAIN=
