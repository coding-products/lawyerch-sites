# ============================================================
# lawyerch-sites · 环境变量模板
# 复制为 .env，只放本地，不要提交
#   cp .env.example .env
# ============================================================

# ---------- 构建 ----------
# 正式域名，决定 canonical、sitemap、hreflang
# 主站：https://lawyerch.cn
# 劳动法站：https://labor.lawyerch.cn
SITE_URL=https://lawyerch.cn

# ---------- Netlify ----------
# 本地已 netlify login 时可省略
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# ---------- Cloudflare（备用） ----------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---------- 百度搜索资源平台 ----------
# 普通收录推送 token
BAIDU_TOKEN=
